{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/windows/", "destination": "/windows.html" },
    { "source": "/window-installation/", "destination": "/window-installation.html" },
    { "source": "/home-windows/", "destination": "/home-windows.html" },
    { "source": "/double-hung-windows/", "destination": "/double-hung-windows.html" },
    { "source": "/doors/", "destination": "/doors.html" },
    { "source": "/gallery/", "destination": "/gallery.html" },
    { "source": "/reviews/", "destination": "/reviews.html" },
    { "source": "/about/", "destination": "/about.html" },
    { "source": "/contact/", "destination": "/contact.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
